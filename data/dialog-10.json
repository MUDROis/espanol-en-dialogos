  "dialogue": [
    { "speaker": "Rubén", "es": "Este es el edificio donde vivo.", "ru": "Вот здание, где я живу." },
    { "speaker": "Lucía", "es": "¿En qué piso vives?", "ru": "На каком этаже ты живёшь?" },
    { "speaker": "Rubén", "es": "En el tercero. Pasa, pasa. El piso está un poco vacío y frío, perdona.", "ru": "На третьем. Проходи, проходи. Квартира немного пустая и холодная, извини." },
    { "speaker": "Lucía", "es": "No pasa nada.", "ru": "Ничего." },
    { "speaker": "Rubén", "es": "Mira, a la izquierda está el salón, al final del pasillo está mi dormitorio.", "ru": "Смотри, слева находится гостиная, а в конце коридора — моя спальня." },
    { "speaker": "Lucía", "es": "¡Qué hermoso es el salón! En mi casa en el salón también hay un sofá marrón, un sillón rojo y la alfombra también es azul.", "ru": "Какая красивая гостиная! В моём доме в гостиной тоже стоит коричневый диван, красное кресло, и ковёр тоже синий." },
    { "speaker": "Rubén", "es": "El salón es muy espacioso, ¿verdad?", "ru": "Зал просторный, правда?" },
    { "speaker": "Lucía", "es": "Sí. Además, es muy luminoso. ¿Y esta puerta...?", "ru": "Да. К тому же светлый. И эта дверь...?" },
    { "speaker": "Rubén", "es": "Ah, es el dormitorio de mi hermana. Está cerrado.", "ru": "Это спальня моей сестры. Она закрыта." },
    { "speaker": "Lucía", "es": "¿Dónde está el cuarto de baño?", "ru": "Где ванная комната?" },
    { "speaker": "Rubén", "es": "Frente a la cocina. El jabón y las toallas están dentro del armario.", "ru": "Напротив кухни. Мыло и полотенца внутри шкафа." },
    { "speaker": "Lucía", "es": "Vale, gracias.", "ru": "Ок, спасибо." },
    { "speaker": "Rubén", "es": "La cocina es grande y cómoda. No tengo cocina de gas pero uso el microondas. Ahora tomamos un café.", "ru": "Кухня большая и удобная. У меня нет газовой плиты, но я использую микроволновку. Сейчас выпьем кофе." },
    { "speaker": "Lucía", "es": "Sí, gracias. Una taza de café con leche, por favor.", "ru": "Да, спасибо. Чашечку кофе с молоком, пожалуйста." }
