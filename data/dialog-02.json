  "dialogue": [
    { "speaker": "Sofía", "es": "¿Cómo te va con el español? ¿Ya estás acostumbrado a la escuela?", "ru": "Как у тебя с испанским? Уже привык к школе?" },
    { "speaker": "Pablo", "es": "Sí, estoy contento, aunque no estoy acostumbrado a las clases en grupo. Los profesores son buenos, pero a veces estoy cansado porque tengo mucha tarea.", "ru": "Да, я доволен, хотя ещё не привык к групповым занятиям. Преподаватели хорошие, но иногда я устаю, потому что много домашнего задания." },
    { "speaker": "Sofía", "es": "Yo también estoy ocupada. Mi hermano tiene 15 años y también estudia aquí, pero no le gusta la escuela. Pasa mucho tiempo con sus amigas.", "ru": "Я тоже занята. Моему брату 15 лет, он тоже учится здесь, но ему не нравится школа. Он проводит много времени с подругами." },
    { "speaker": "Pablo", "es": "¿Vivís juntos?", "ru": "Вы живёте вместе?" },
    { "speaker": "Sofía", "es": "Sí, vivo con mi hermano en casa de unos amigos de la familia.", "ru": "Да, я живу с братом в доме друзей семьи." },
    { "speaker": "Pablo", "es": "Yo vivo con un compañero de piso, de Portugal. Estamos acostumbrados a cocinar juntos.", "ru": "Я живу с соседом по комнате, из Португалии. Мы привыкли готовить вместе." },
    { "speaker": "Sofía", "es": "¿Y tu familia, están en Buenos Aires?", "ru": "А твоя семья, они в Буэнос-Айресе?" }
  ],
