  "grammar": {
    "ser_hora_es_son": {
      "title": "Для времени нужен глагол ser: es — son",
      "description": "Время в испанском отвечает глагол ser. Одна отметка — es: es la una (час), es la una y media (половина второго). Две и больше — son: son las dos, son las diez, son las cinco y media. Час почти всегда стоит во множественном числе: son las…, и только la una — женского рода, поэтому es. Добавки de la mañana / de la tarde / de la noche — это «контейнеры» времени: son las diez de la mañana (десять утра).",
      "forms": {
        "yo": {
          "es": "es la una",
          "ru": "час"
        },
        "tu": {
          "es": "¿qué hora es?",
          "ru": "который час?"
